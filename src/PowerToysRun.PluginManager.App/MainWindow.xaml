<Window x:Class="PowerToysRun.PluginManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PowerToys Run Plugin Manager"
        Icon="Assets/plugin-manager.png"
        Width="1100"
        Height="760"
        MinWidth="780"
        MinHeight="540"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Padding="14,20,14,16"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Grid Margin="6,0,6,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Width="28" Height="28" VerticalAlignment="Top"
                               Source="Assets/plugin-manager.png"
                               AutomationProperties.Name="Plugin Manager logo" />
                        <StackPanel Grid.Column="1" Margin="9,0,0,0">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Plugin Manager" />
                            <TextBlock Margin="0,2,0,0" FontSize="12" Opacity="0.66"
                                       Text="for PowerToys Run" />
                        </StackPanel>
                    </Grid>

                    <RadioButton x:Name="DiscoverNavigation"
                                 GroupName="Nav"
                                 IsChecked="True"
                                 Tag="Discover"
                                 Content="Discover"
                                 Style="{StaticResource NavigationRadioButtonStyle}"
                                 Checked="Navigation_Checked" />
                    <RadioButton x:Name="InstalledNavigation"
                                 GroupName="Nav"
                                 Tag="Installed"
                                 Content="Installed"
                                 Style="{StaticResource NavigationRadioButtonStyle}"
                                 Checked="Navigation_Checked" />
                    <RadioButton x:Name="UpdatesNavigation"
                                 GroupName="Nav"
                                 Tag="Updates"
                                 Content="Updates"
                                 Style="{StaticResource NavigationRadioButtonStyle}"
                                 Checked="Navigation_Checked" />
                </StackPanel>

                <TextBlock Grid.Row="2" Margin="6,0" FontSize="12" Opacity="0.60"
                           TextWrapping="Wrap"
                           Text="Queue everything you want. PowerToys only closes once, when you apply the changes." />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="26,22,26,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="CatalogPane" Visibility="{Binding CatalogVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock FontSize="30" FontWeight="SemiBold" Text="{Binding PageTitle}" />

                <Border Grid.Row="1" Margin="0,14,0,0" Padding="12"
                        CornerRadius="9" BorderThickness="1"
                        BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                        Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                        Visibility="{Binding UpdateVisibility}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                   Text="{Binding UpdateMessage}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Margin="8,0,0,0" Content="View release"
                                    Click="ViewManagerRelease_Click" />
                            <Button Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Download and install" Click="InstallManagerUpdate_Click" />
                            <Button Margin="8,0,0,0" Padding="10,7" Content="Later"
                                    Click="DismissManagerUpdate_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBox x:Name="SearchBox" Grid.Row="2" Margin="0,16,0,12"
                         AutomationProperties.Name="Search plugins"
                         ToolTip="Search by plugin name, author, description, or tag"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <ListBox x:Name="PluginList"
                         Grid.Row="3"
                         ItemsSource="{Binding VisiblePlugins}"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PreviewMouseWheel="PluginList_PreviewMouseWheel"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,5" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PluginCardButtonStyle}"
                                    Tag="{Binding}"
                                    AutomationProperties.Name="{Binding Name}"
                                    AutomationProperties.HelpText="{Binding Description}"
                                    Click="OpenDetails_Click">
                                <Grid Margin="14,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="54" Height="54"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                            CornerRadius="11">
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="23" Opacity="0.38" Text="&#xE71D;" />
                                            <Image Width="46" Height="46"
                                                   Source="{Binding DisplayIconUrl}"
                                                   Stretch="Uniform"
                                                   ImageFailed="RemoteImage_ImageFailed"
                                                   AutomationProperties.Name="{Binding Name, StringFormat={}{0} icon}" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,18,0">
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Margin="0,2,0,0" FontSize="13" Opacity="0.66"
                                                   Text="{Binding AuthorLine}" />
                                        <TextBlock Margin="0,7,0,0" TextWrapping="Wrap"
                                                   MaxHeight="40" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Description}" />
                                        <TextBlock Margin="0,6,0,0" FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                                   Visibility="{Binding StatusVisibility}"
                                                   Text="{Binding StatusLabel}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Margin="4,0,2,0"
                                               VerticalAlignment="Center"
                                               FontSize="23" Opacity="0.48" Text="›" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <ScrollViewer x:Name="DetailView"
                          Visibility="{Binding DetailVisibility}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,12">
                    <Button Margin="0,0,0,16"
                            Padding="10,6"
                            HorizontalAlignment="Left"
                            Content="←  Back to plugins"
                            Click="BackToCatalog_Click" />

                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="78" Height="78"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                CornerRadius="16">
                            <Grid>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="30" Opacity="0.38" Text="&#xE71D;" />
                                <Image Width="66" Height="66"
                                       Source="{Binding SelectedPlugin.DisplayIconUrl}"
                                       Stretch="Uniform"
                                       ImageFailed="RemoteImage_ImageFailed"
                                       AutomationProperties.Name="{Binding SelectedPlugin.Name, StringFormat={}{0} icon}" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="30" FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Text="{Binding SelectedPlugin.Name}" />
                            <TextBlock Margin="0,5,0,0" FontSize="14" Opacity="0.68"
                                       Text="{Binding SelectedPlugin.AuthorLine}" />
                            <TextBlock Margin="0,8,0,0" FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                       Visibility="{Binding SelectedPlugin.StatusVisibility}"
                                       Text="{Binding SelectedPlugin.StatusLabel}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,0,0,18" FontSize="16" Opacity="0.82"
                               TextWrapping="Wrap"
                               Text="{Binding SelectedPlugin.Description}" />

                    <WrapPanel Margin="0,0,0,22">
                        <Button Margin="0,0,9,9"
                                MinWidth="126"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="{Binding SelectedPlugin.PrimaryActionLabel}"
                                Tag="{Binding SelectedPlugin}"
                                IsEnabled="{Binding SelectedPlugin.CanUsePrimaryAction}"
                                Click="PrimaryAction_Click" />
                        <Button Margin="0,0,9,9"
                                MinWidth="126"
                                Content="View repository"
                                Tag="{Binding SelectedPlugin.RepositoryUrl}"
                                Click="Repository_Click" />
                        <Button Margin="0,0,9,9"
                                MinWidth="104"
                                Content="{Binding SelectedPlugin.RemoveActionLabel}"
                                Tag="{Binding SelectedPlugin}"
                                Visibility="{Binding SelectedPlugin.RemoveVisibility}"
                                Click="Remove_Click" />
                    </WrapPanel>

                    <Border Margin="0,0,0,16"
                            Padding="18"
                            CornerRadius="11"
                            Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                            Visibility="{Binding SelectedPlugin.ScreenshotsVisibility}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,14" FontSize="18" FontWeight="SemiBold"
                                       Text="Screenshots" />
                            <ItemsControl ItemsSource="{Binding SelectedPlugin.ScreenshotUrls}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="342" Height="206"
                                                Style="{StaticResource ScreenshotButtonStyle}"
                                                Tag="{Binding}"
                                                Click="Screenshot_Click">
                                            <Border Padding="1"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                                                <Image Source="{Binding}"
                                                       Stretch="Uniform"
                                                       ImageFailed="RemoteImage_ImageFailed"
                                                       AutomationProperties.Name="Plugin screenshot" />
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Padding="18"
                            CornerRadius="11"
                            Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,12" FontSize="18" FontWeight="SemiBold"
                                       Text="Description" />
                            <TextBlock FontSize="15" LineHeight="23"
                                       TextWrapping="Wrap"
                                       Text="{Binding SelectedPlugin.DetailsDescription}" />
                            <TextBlock Margin="0,16,0,0" FontSize="13" Opacity="0.64"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding SelectedPlugin.TagsVisibility}"
                                       Text="{Binding SelectedPlugin.TagsLine}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="2,16,2,0" FontSize="12" Opacity="0.58"
                               TextWrapping="Wrap"
                               Text="Community plugins are created and maintained by third parties. Review the repository before installing code you do not trust." />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Opacity="0.68" Text="{Binding StatusText}" />
                    <ProgressBar Width="120" Height="4" Margin="0,5,0,0"
                                 HorizontalAlignment="Left" IsIndeterminate="True"
                                 Visibility="{Binding BusyVisibility}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding QueueVisibility}">
                    <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" FontWeight="SemiBold"
                               Text="{Binding QueueSummary}" />
                    <Button Content="Clear" Click="ClearQueue_Click" />
                    <Button Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}"
                            Content="{Binding ApplyQueueLabel}" Click="ApplyQueue_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
